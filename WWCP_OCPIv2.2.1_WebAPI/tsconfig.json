{
  "compileOnSave": true,
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [ "ES2022", "DOM", "DOM.Iterable" ],

    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,

    "isolatedModules": false,
    "verbatimModuleSyntax": false,
    "allowJs": false,
    "skipLibCheck": true,

    "sourceMap": true,
    "removeComments": false,
    "newLine": "lf"
  },
  "files": [

    "HTTPRoot/defaults/defaults.ts",
    "HTTPRoot/defaults/OCPIv2.2.1.ts",

    "HTTPRoot/versions/versions.ts",
    "HTTPRoot/versions/versionDetails.ts",

    "HTTPRoot/cdrs/cdrs.ts",
    "HTTPRoot/locations/locations.ts",
    "HTTPRoot/locations/locationStatistics.ts",
    "HTTPRoot/sessions/sessions.ts",
    "HTTPRoot/tariffs/tariffs.ts",
    "HTTPRoot/tokens/tokens.ts",

    "HTTPRoot/remoteParties/remoteParties.ts",
    "HTTPRoot/remoteParties/remoteParty.ts",

    "HTTPRoot/remoteParty/remoteCPO/reserveNow.ts",
    "HTTPRoot/remoteParty/remoteCPO/cancelReservation.ts",
    "HTTPRoot/remoteParty/remoteCPO/startSession.ts",
    "HTTPRoot/remoteParty/remoteCPO/stopSession.ts",
    "HTTPRoot/remoteParty/remoteCPO/unlockConnector.ts",

    "HTTPRoot/debugLog/debugLog.ts"

  ]
}
